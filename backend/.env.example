# For local Go development
# Server
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/local_events_db

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Chapa Payment
CHAPA_SECRET_KEY=your-chapa-secret-key
CHAPA_PUBLIC_KEY=your-chapa-public-key
CHAPA_CALLBACK_URL=http://localhost:3001/webhook/chapa
CHAPA_RETURN_URL=http://localhost:3000/payment/success
