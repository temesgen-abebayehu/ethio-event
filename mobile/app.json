{
    "expo": {
        "name": "LocalEvent",
        "slug": "localevent",
        "scheme": "localevent",
        "version": "1.0.0",
        "orientation": "portrait",
        "userInterfaceStyle": "light",
        "splash": {
            "backgroundColor": "#6366f1"
        },
        "assetBundlePatterns": [
            "**/*"
        ],
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.localevent.app"
        },
        "android": {
            "package": "com.localevent.app"
        },
        "plugins": [
            "expo-router",
            "expo-secure-store",
            [
                "expo-camera",
                {
                    "cameraPermission": "Allow LocalEvent to use the camera to scan ticket QR codes."
                }
            ]
        ],
        "experiments": {
            "typedRoutes": false
        }
    }
}